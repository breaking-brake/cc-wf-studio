{
  "name": "@cc-wf-studio/cli",
  "version": "0.2.2",
  "description": "Command-line tool for cc-wf-studio: render, validate, and run workflows, plus a stdio MCP server entry.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ccwf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/breaking-brake/cc-wf-studio",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run sync:webview && pnpm run sync:skills && tsc && chmod +x dist/cli.js",
    "sync:webview": "rm -rf dist/webview && mkdir -p dist/webview && cp -R ../vscode/src/webview/dist/. dist/webview/",
    "sync:skills": "rm -rf dist/skills && mkdir -p dist/skills && cp -R skills/. dist/skills/",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "lint": "echo 'cli: no lint config yet'",
    "format": "echo 'cli: no format config yet'",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cc-wf-studio/core": "workspace:*",
    "@cc-wf-studio/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/ws": "^8.5.13",
    "cc-wf-studio-webview": "workspace:*",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
